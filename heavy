#!/usr/bin/env bash
# heavy — machine-wide queue for heavy verification commands (pytest, vitest,
# tsc, pyright, lint, build).
#
# Several agent sessions on one laptop each running their own test suite at the
# same moment is what pins the CPU, not the agents themselves: they spend most of
# their time waiting on the model. heavy lets at most HEAVY_SLOTS of those
# commands run at once; the rest wait their turn instead of fighting for CPU.
# Everything runs at low priority so the desktop stays responsive.
#
#   heavy uv run pytest -n 3 tests/unit/foo
#   heavy --timeout 600 bun run test   # the wait in the queue doesn't count
#   heavy --status                     # who holds each slot
#   ./heavy --install                  # once per machine (from a clone)
#
# Env:
#   HEAVY_SLOTS  concurrent slots (default: CPUs/4, at least 1)
#   HEAVY_WAIT   max seconds waiting for a slot (default 1800); then exit 75
#   HEAVY_LOCK   lock file base path (default: per-user, machine-wide)
#
# Never wrap a dev server or anything that doesn't exit: it would hold a slot.
#
# Portability: Linux, WSL2 and macOS (bash 3.2). A missing tool never stops the
# command from running, it only drops that protection:
#   queue     flock(1); else perl's flock (ships with macOS); else no queue
#   priority  nice; ionice where it exists (Linux/WSL)
#   CPU/RAM   cap shared by all jobs, via the systemd user slice heavy.slice,
#             written by --install where systemd --user works (Linux; WSL2 only
#             with systemd enabled in /etc/wsl.conf). Not available on macOS.
set -u

# Real path of this script, following symlinks (~/.local/bin/heavy points here).
# No `readlink -f`: older macOS doesn't have it.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
self="$(cd "$(dirname "$self")" && pwd)/$(basename "$self")"

usage() {
  sed -n '2,32p' "$self" | sed 's/^# \{0,1\}//' >&2
}

have() { command -v "$1" >/dev/null 2>&1; }

cpu_count() {
  getconf _NPROCESSORS_ONLN 2>/dev/null || nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4
}

# A fixed path, not $TMPDIR: on macOS and in some sandboxes TMPDIR differs per
# process tree, and the queue only works if every session sees the same lock.
default_lock() {
  if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ -w "$XDG_RUNTIME_DIR" ]; then
    echo "$XDG_RUNTIME_DIR/heavy.lock"
  else
    echo "/tmp/heavy-$(id -u).lock"
  fi
}

slice_file="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/heavy.slice"

systemd_user_ok() {
  [ "$(uname -s)" = Linux ] && have systemd-run && have systemctl &&
    systemctl --user show-environment >/dev/null 2>&1
}

is_wsl() { grep -qi microsoft /proc/version 2>/dev/null; }

install_heavy() {
  local repo_script bin cpus quota mem_kb mem_high
  repo_script="$self"
  bin="$HOME/.local/bin"
  mkdir -p "$bin"
  ln -sfn "$repo_script" "$bin/heavy"
  echo "[heavy] linked $bin/heavy -> $repo_script"
  case ":$PATH:" in
    *":$bin:"*) ;;
    *) echo "[heavy] $bin is not on PATH; add it in your shell rc: export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
  esac

  if have flock; then
    echo "[heavy] queue: flock"
  elif have perl; then
    echo "[heavy] queue: perl flock (fine; 'brew install flock' also works on macOS)"
  else
    echo "[heavy] WARNING: neither flock nor perl found; heavy will run commands without the queue"
  fi

  if systemd_user_ok; then
    cpus=$(cpu_count)
    # The whole queue gets ~5/8 of the cores and ~45% of RAM, leaving the rest to
    # the desktop and the agent sessions. One multithreaded job (tsc 7 alone uses
    # ~3 cores and several GB) can't take the machine anymore.
    quota=$(( cpus * 500 / 8 ))
    [ "$quota" -lt 100 ] && quota=100
    mem_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
    mem_high="$(( mem_kb * 45 / 100 / 1024 ))M"
    mkdir -p "$(dirname "$slice_file")"
    cat > "$slice_file" <<EOF
# Written by heavy --install; rerun it to resize. Cap shared by every job heavy
# runs, not per job.
[Unit]
Description=heavy queue (pytest/vitest/tsc/pyright/build)

[Slice]
CPUQuota=${quota}%
# MemoryHigh doesn't kill: above it the kernel reclaims memory from THIS slice
# first, instead of pushing the desktop and the agent sessions into swap.
MemoryHigh=${mem_high}
EOF
    systemctl --user daemon-reload
    echo "[heavy] CPU/RAM cap: $slice_file (CPUQuota=${quota}% of ${cpus} CPUs, MemoryHigh=${mem_high})"
  elif is_wsl; then
    echo "[heavy] CPU/RAM cap: off (WSL without systemd). Optional: put these two lines in /etc/wsl.conf,"
    echo "        then run 'wsl --shutdown' from Windows and rerun --install:"
    echo "          [boot]"
    echo "          systemd=true"
  else
    echo "[heavy] CPU/RAM cap: not available on this OS (queue and priority still apply)"
  fi
  echo "[heavy] slots: ${HEAVY_SLOTS:-$(default_slots)} (override with HEAVY_SLOTS)"
}

default_slots() {
  local s=$(( $(cpu_count) / 4 ))
  [ "$s" -lt 1 ] && s=1
  echo "$s"
}

base="${HEAVY_LOCK:-$(default_lock)}"
slots="${HEAVY_SLOTS:-$(default_slots)}"
wait_max="${HEAVY_WAIT:-1800}"

# Slot 0 is $base itself; the others are $base.N.
slot_path() { if [ "$1" -eq 0 ]; then echo "$base"; else echo "$base.$1"; fi; }

# Non-blocking lock on fd 9. flock(2) locks belong to the open file, so perl
# locking the fd it inherited keeps the lock held by this shell after perl exits.
lock_fd9() {
  if have flock; then
    flock -n 9
  elif have perl; then
    perl -MFcntl=:flock -e 'exit(flock(STDIN, LOCK_EX | LOCK_NB) ? 0 : 1)' <&9
  else
    return 0
  fi
}

status() {
  local i p
  echo "slots: $slots, lock: $base"
  for ((i = 0; i < slots; i++)); do
    p="$(slot_path "$i")"
    exec 9>>"$p"
    if lock_fd9; then
      echo "  [$i] free"
    else
      echo "  [$i] $(cat "$p.owner" 2>/dev/null || echo '?')"
    fi
    exec 9>&-
  done
}

timeout_s=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --install) install_heavy; exit $? ;;
    --status) status; exit 0 ;;
    --timeout)
      [ $# -ge 2 ] || { echo "[heavy] --timeout needs seconds" >&2; exit 2; }
      timeout_s="$2"; shift 2 ;;
    --timeout=*) timeout_s="${1#--timeout=}"; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done

if [ $# -eq 0 ]; then
  usage
  exit 2
fi

# Already inside a heavy (e.g. `heavy make check` calling `heavy pytest`): don't
# take a second slot, or it can deadlock waiting on itself.
if [ -n "${HEAVY_HELD:-}" ]; then
  exec "$@"
fi

slot=""
try_slots() {
  local i
  for ((i = 0; i < slots; i++)); do
    exec 9>>"$(slot_path "$i")"
    if lock_fd9; then
      slot="$(slot_path "$i")"
      return 0
    fi
    exec 9>&-
  done
  return 1
}

if ! have flock && ! have perl; then
  echo "[heavy] warning: no flock or perl; running without the queue" >&2
elif ! try_slots; then
  echo "[heavy] queued; slots held by:" >&2
  for ((i = 0; i < slots; i++)); do
    echo "  - $(cat "$(slot_path "$i").owner" 2>/dev/null || echo '?')" >&2
  done
  start=$SECONDS
  until try_slots; do
    if ((SECONDS - start >= wait_max)); then
      echo "[heavy] gave up after ${wait_max}s in the queue" >&2
      exit 75
    fi
    sleep 1
  done
  echo "[heavy] my turn after $((SECONDS - start))s" >&2
fi
[ -n "$slot" ] && echo "pid $$ since $(date +%T) in $PWD: $*" > "$slot.owner"

export HEAVY_HELD=1

# Build the launch command by prepending, not with an array: bash 3.2 (macOS)
# treats an empty array as unbound under set -u.
have nice && set -- nice -n 10 "$@"
have ionice && set -- ionice -c2 -n7 "$@"
# systemd-run --scope execs the command in place (same pid), so the signal
# forwarding below still reaches the real command.
if [ -f "$slice_file" ] && have systemd-run &&
  systemd-run --user --scope --slice=heavy.slice --quiet -- true 2>/dev/null; then
  set -- systemd-run --user --scope --slice=heavy.slice --quiet -- "$@"
fi

# Signal the command and everything under it. `sh -c 'a; b'` forks instead of
# exec'ing, so signalling only the direct child would orphan the real work.
# (A new process group would be simpler, but a background group reading the
# terminal gets stopped by SIGTTIN.)
descendants() {
  local c
  for c in $(pgrep -P "$1" 2>/dev/null); do
    descendants "$c"
    echo "$c"
  done
}
# shellcheck disable=SC2046  # the pid list is meant to split into arguments
kill_tree() { kill -"$1" "$2" $(descendants "$2") 2>/dev/null; }

# 9>&- : children don't inherit the lock, so a process left running in the
# background doesn't keep holding the slot after this script exits.
"$@" 9>&- <&0 &
child=$!
# timeout / Ctrl-C / kill on this script must reach the command, not orphan it.
trap 'kill_tree TERM "$child"' INT TERM HUP

# Our own timeout instead of coreutils `timeout`, which macOS doesn't ship.
watchdog=""
timed_out_mark=""
if [ -n "$timeout_s" ]; then
  timed_out_mark="$(mktemp "/tmp/heavy-timeout.XXXXXX")"
  rm -f "$timed_out_mark"
  (
    sleep "$timeout_s"
    # Only a timeout if the command is still running; otherwise this is just the
    # cleanup below racing us.
    kill -0 "$child" 2>/dev/null || exit 0
    : > "$timed_out_mark"
    echo "[heavy] timeout after ${timeout_s}s, stopping the command" >&2
    kill_tree TERM "$child"
    sleep 10
    kill_tree KILL "$child"
  ) 9>&- &
  watchdog=$!
fi

wait "$child"
rc=$?
while kill -0 "$child" 2>/dev/null; do
  wait "$child"
  rc=$?
done

if [ -n "$watchdog" ]; then
  kill_tree TERM "$watchdog"
  wait "$watchdog" 2>/dev/null
  if [ -f "$timed_out_mark" ]; then
    rm -f "$timed_out_mark"
    rc=124
  fi
fi
exit "$rc"
